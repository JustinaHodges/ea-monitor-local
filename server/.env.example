PORT=8787
# 本机-only: 127.0.0.1    局域网: 0.0.0.0（也可用仓库根目录「一键启动-局域网.bat」）
HOST=127.0.0.1
ADMIN_TOKEN=change-me-to-a-long-random-string
NOTIFY_WEBHOOK=
OFFLINE_AFTER_SECONDS=180
DATA_DIR=./data

LICENSE_ENFORCE=0
LICENSE_SECRET=

# 从主站接收弹窗广告（登录后每天弹一次；主站改文案后下次登录可见）
# 不写这一行也默认拉 https://www.688118.xyz/api/v1/promo-ad
# 若要关闭远程广告，写成：PROMO_AD_SOURCE=
PROMO_AD_SOURCE=https://www.688118.xyz/api/v1/promo-ad
